# Copie para .env na raiz do projeto; não versione o arquivo preenchido.
DB_HOST=host_mysql_informado_pela_kinghost
DB_NAME=nome_da_base
DB_USER=usuario_da_base
DB_PASS=
DB_CHARSET=utf8mb4

# URL pública HTTPS, sem barra no final, onde a aplicação está instalada.
APP_URL=https://seudominio.com.br/pagueprof
# E-mail transacional (SMTP). Obtenha host/porta/usuário/senha no provedor de e-mail.
# Preferir TLS na porta 587 ou SSL na porta 465; use um remetente autorizado no domínio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURITY=tls
MAIL_FROM=
MAIL_FROM_NAME=PagueProf
